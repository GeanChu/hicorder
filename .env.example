# Hicorder Development Environment Variables
# Copy this file to .env and fill in your values (do not commit .env)

# ============================================================
# Optional: Custom ffmpeg path for development
# ============================================================
# In production, ffmpeg is bundled. In dev, the app uses:
# 1. CALLREC_FFMPEG environment variable
# 2. ffmpeg from PATH
# 3. Error if neither is found
# CALLREC_FFMPEG=/usr/local/bin/ffmpeg

# ============================================================
# API Keys (for testing only)
# ============================================================
# The app stores keys in the OS keychain, not in .env.
# These are provided as reference for what you'll need to configure
# through the app's Settings UI.

# Transcription (Speech-to-Text)
# Choose one provider and get an API key:
# - Groq (default, has free tier): https://console.groq.com/keys
# - OpenAI: https://platform.openai.com/api-keys
# - Fireworks AI: https://fireworks.ai (API Keys section)
# GROQ_API_KEY=your_groq_key_here

# Summary (LLM)
# Choose one provider and get an API key:
# - OpenAI: https://platform.openai.com/api-keys
# - Claude (Anthropic): https://console.anthropic.com/settings/keys
# - Google Gemini: https://aistudio.google.com/apikey
# - MiniMax: Subscription Key from your account or https://platform.minimax.io
# - NVIDIA NIM: https://build.nvidia.com (API key starts with nvapi-)
# - Claude Code (local): No key needed, uses your Claude subscription
# OPENAI_API_KEY=your_openai_key_here

# CRM Integration
# Choose one CRM and get an API key:
# - Attio: Settings → Developers → API tokens
# - Affinity: Settings → API
# ATTIO_API_KEY=your_attio_key_here
# AFFINITY_API_KEY=your_affinity_key_here

# Calendar (ICS URL)
# Get your private calendar URL (ICS format):
# - Google Calendar: Settings → Settings for my calendars → [Calendar] → 
#   Secret address in iCalendar format
# - Outlook: Calendar → Settings → Shared calendars → Publish calendar → 
#   ICS format
# Warning: This URL is a credential - anyone with it can read your calendar
# ICS_CALENDAR_URL=https://calendar.google.com/calendar/ical/...

# ============================================================
# Development Settings
# ============================================================
# Rust build target directory (useful if Dropbox/OneDrive syncs your workspace)
# CARGO_TARGET_DIR=target

# Rust log level for development
# RUST_LOG=debug
